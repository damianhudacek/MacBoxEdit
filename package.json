{
  "name": "macboxedit",
  "private": true,
  "main": "dist-electron/main.js",
  "version": "1.0.0",
  "description": "Professional Enigma2 Channel Editor for macOS",
  "author": "Dmytro <huddan@example.com>",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "build:mac": "tsc -b && vite build && electron-builder --mac --arm64",
    "release": "tsc -b && vite build && electron-builder --mac --arm64 --publish always"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/damianhudacek/MacBoxEdit.git"
  },
  "build": {
    "appId": "com.macboxedit.app",
    "productName": "MacBoxEdit",
    "publish": [
      {
        "provider": "github",
        "owner": "damianhudacek",
        "repo": "MacBoxEdit"
      }
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "icon": "icon.icns",
      "target": [
        "dmg"
      ],
      "hardenedRuntime": true,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "Aplikácia potrebuje prístup k lokálnej sieti na pripojenie k prijímaču Enigma2."
      }
    },
    "dmg": {
      "icon": "icon.icns",
      "title": "MacBoxEdit ${version}",
      "contents": [
        {
          "x": 410,
          "y": 150,
          "path": "/Applications",
          "type": "link"
        },
        {
          "x": 130,
          "y": 150,
          "type": "file"
        }
      ]
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "basic-ftp": "^5.2.0",
    "electron-updater": "^6.8.3",
    "lucide-react": "^0.577.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.2.1",
    "electron": "^41.0.2",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.27.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.0",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.6",
    "wait-on": "^9.0.4"
  }
}
